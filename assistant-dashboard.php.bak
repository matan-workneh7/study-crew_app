    <script>
    // Key for localStorage - unique per user
    const STORAGE_KEY = 'assistant_courses_' + <?php echo json_encode($userId); ?>;
    
    // Initialize selected courses from localStorage
    let selectedCourses = new Set(JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'));

    // Function to update checkboxes based on selected courses
    function updateCheckboxes() {
        document.querySelectorAll('input[type=checkbox][name="selected_courses[]"]').forEach(cb => {
            cb.checked = selectedCourses.has(cb.value);
        });
    }

    // Function to save selected courses to localStorage
    function saveSelectedCourses() {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(Array.from(selectedCourses)));
        sessionStorage.setItem('temp_selected_courses', JSON.stringify(Array.from(selectedCourses)));
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Initialize checkboxes
        updateCheckboxes();
        
        // Handle checkbox changes
        document.addEventListener('change', function(e) {
            const checkbox = e.target;
            if (checkbox.name === 'selected_courses[]') {
                if (checkbox.checked) {
                    selectedCourses.add(checkbox.value);
                } else {
                    selectedCourses.delete(checkbox.value);
                }
                saveSelectedCourses();
            }
        });
        
        // Handle year/semester navigation
        document.querySelectorAll('.year-list a, .semester-list a').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                // Save current selections before navigating
                saveSelectedCourses();
                window.location.href = this.href;
            });
        });
        
        // Handle form submission
        document.querySelector('form').addEventListener('submit', function(e) {
            e.preventDefault();
            
            // Remove any existing hidden inputs to prevent duplicates
            document.querySelectorAll('input[name="selected_courses[]"][type=hidden]').forEach(el => el.remove());
            
            // Convert Set to Array to remove duplicates, then add hidden inputs
            const uniqueCourses = Array.from(selectedCourses);
            console.log('Submitting courses:', uniqueCourses);
            
            // Add hidden inputs for all selected courses (without duplicates)
            uniqueCourses.forEach(courseId => {
                const hidden = document.createElement('input');
                hidden.type = 'hidden';
                hidden.name = 'selected_courses[]';
                hidden.value = courseId;
                this.appendChild(hidden);
            });
            
            // Submit the form
            this.submit();
        });
    });
    </script>
</body>
</html>
