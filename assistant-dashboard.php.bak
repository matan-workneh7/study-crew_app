<?php
require_once 'session.php';
include 'functions.php';

// Redirect to login if not logged in
if (!isLoggedIn()) {
    header("Location: index.php?action=login&intent=assist");
    exit();
}

// Redirect users not logged in as assistant to courses page
if (!isset($_SESSION['user_role']) || $_SESSION['user_role'] !== 'assist') {
    header("Location: courses.php");
    exit();
}

// Check for success or error messages from profile creation
$successMessage = '';
$errorMessage = '';

if (isset($_SESSION['success'])) {
    $successMessage = $_SESSION['success'];
    unset($_SESSION['success']); // Clear the message after displaying
}

if (isset($_SESSION['error_message'])) {
    $errorMessage = $_SESSION['error_message'];
    unset($_SESSION['error_message']); // Clear the message after displaying
}

// Get user data
$userId = $_SESSION['user_id'];
$userData = getUserData($userId);
$userYear = $userData['academic_year'];

// Convert academic year to numeric value for comparison
$yearValues = [
    'Freshman' => 1,
    'Sophomore' => 2,
    'Junior' => 3,
    'Senior' => 4,
    'Graduate' => 5
];

$userYearValue = $yearValues[$userYear] ?? 1;

// Get selected year from URL parameter or default to first available year below user's year
$selectedYear = 1;
foreach ($yearValues as $yearName => $yearNum) {
    if ($yearNum < $userYearValue) {
        $selectedYear = $yearNum;
        break;
    }
}
$selectedYear = isset($_GET['year']) ? (int)$_GET['year'] : $selectedYear;

// Ensure we have a valid year name
$selectedYearName = array_search($selectedYear, $yearValues);
if ($selectedYearName === false) {
    $selectedYear = 1;
    $selectedYearName = 'Freshman';
}

// Get selected semester from URL parameter or default to first semester
$selectedSemester = isset($_GET['semester']) ? (int)$_GET['semester'] : 1;

// Get all courses assigned to this assistant
$assistantCourses = getCoursesForAssistant($userId);

// Debug log
error_log("Assistant ID: " . $userId . ", Assistant courses: " . count($assistantCourses));

// Filter courses by selected year and semester
$selectedYearName = is_numeric($selectedYear) ? getYearName($selectedYear) : $selectedYear;
$courses = [];

// Debug log
error_log("Filtering courses - Selected Year: $selectedYear ($selectedYearName), Semester: $selectedSemester");

foreach ($assistantCourses as $course) {
    $courseYear = $course['year'];
    $courseSemester = $course['semester'];
    
    // Debug log for each course
    error_log(sprintf(
        "Course: %-30s | Year: %-10s | Semester: %d | Selected Year: %s | Selected Semester: %d",
        $course['name'],
        $courseYear,
        $courseSemester,
        $selectedYearName,
        $selectedSemester
    ));
    
    if ($courseYear === $selectedYearName && $courseSemester == $selectedSemester) {
        $courses[] = $course;
    }
}

// Debug log
error_log("Total available courses: " . count($assistantCourses));
error_log("Filtered courses for {$selectedYearName} Semester {$selectedSemester}: " . count($courses));

// Get courses the user is already assisting
$assistingCourses = getAssistantCourses($userId);
$assistingCourseIds = array_column($assistingCourses, 'course_id');

// Handle form submission
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    error_log("Form submitted in assistant-dashboard.php");
    
    // Get and clean selected courses
    $selectedCourses = [];
    if (isset($_POST['selected_courses']) && is_array($_POST['selected_courses'])) {
        $selectedCourses = array_map('trim', $_POST['selected_courses']);
        $selectedCourses = array_filter($selectedCourses, function($value) {
            return !empty($value);
        });
        // Ensure unique course IDs
        $selectedCourses = array_values(array_unique($selectedCourses));
    }
    
    error_log("Processed selected courses: " . print_r($selectedCourses, true));
    
    // Store selected courses in session
    $_SESSION['assistant_courses'] = $selectedCourses;
    
    // Check if user already has an assistant profile
    error_log("Checking if user has an assistant profile...");
    $assistantId = isUserAssistant($userId);
    error_log("Assistant ID from isUserAssistant: " . ($assistantId ?: 'false'));
    
    if ($assistantId !== false) {
        error_log("Updating existing assistant profile with ID: $assistantId");
        
        try {
            // If assistant profile exists, update courses directly
            error_log("Calling updateAssistantCourses with assistant ID: $assistantId");
            $result = updateAssistantCourses($assistantId, $selectedCourses);
            error_log("updateAssistantCourses result: " . ($result ? 'true' : 'false'));
            
            if ($result) {
                $_SESSION['success_message'] = 'Your course selections have been updated successfully!';
                header('Location: ' . $_SERVER['PHP_SELF']);
                exit();
            } else {
                throw new Exception("updateAssistantCourses returned false");
            }
            
        } catch (Exception $e) {
            // Get the last error from error log
            $error_log = file_get_contents('/opt/lampp/logs/php_error_log');
            $last_error = $e->getMessage();
            
            error_log("Error updating assistant courses: " . $last_error);
            error_log("Stack trace: " . $e->getTraceAsString());
            
            $_SESSION['error_message'] = 'Failed to update course selections. ' . 
                                      ($last_error ? "Error: $last_error" : "Please try again.");
        }
    } else {
        error_log("No assistant profile found, checking if user has a profile...");
        
        // Check if user has a basic profile (not just assistant profile)
        $userData = getUserData($userId);
        if (!$userData) {
            error_log("User data not found for ID: $userId");
            $_SESSION['error_message'] = 'User data not found. Please log in again.';
        } else {
            error_log("Redirecting to assistant-profile.php to complete profile");
            // Store selected courses in session for the profile page
            $_SESSION['temp_selected_courses'] = $selectedCourses;
            
            // Redirect to profile completion
            header('Location: assistant-profile.php');
            exit();
        }
    }
}
?>

