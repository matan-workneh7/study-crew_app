            <a href="assistant-dashboard.php" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
            
            <form method="POST" action="" class="profile-form">
                <div class="form-group">
                    <label>Username</label>
                    <div class="readonly-field">
                        <?php echo htmlspecialchars($userData['username'] ?? $_SESSION['username']); ?>
                    </div>
                    <input type="hidden" name="full_name" value="<?php echo htmlspecialchars($userData['username'] ?? $_SESSION['username']); ?>">
                </div>
                
                <div class="form-group">
                    <label for="bio">Bio</label>
                    <textarea id="bio" name="bio" rows="4" 
                              placeholder="Tell students about yourself and your teaching experience"><?php echo htmlspecialchars($userData['bio'] ?? ''); ?></textarea>
                </div>
                
                <div class="form-group">
                    <label for="availability">Availability</label>
                    <input type="text" id="availability" name="availability" 
                           placeholder="e.g., Weekdays after 5 PM, Weekends"
                           value="<?php echo htmlspecialchars($userData['availability'] ?? ''); ?>">
                </div>
                
                <div class="form-group">
                    <label for="contact_info">Preferred Contact Information</label>
                    <input type="text" id="contact_info" name="contact_info" 
                           placeholder="Email or phone number"
                           value="<?php echo htmlspecialchars($userData['contact_info'] ?? ''); ?>">
                </div>
                
                <div class="selected-courses">
                    <h3>Selected Courses</h3>
                    <div class="course-chips" id="selected-courses-list">
                        <?php 
                        $courses = isset($_SESSION['assistant_courses']) ? getCoursesByIds($_SESSION['assistant_courses']) : [];
                        foreach ($courses as $course): 
                        ?>
                            <span class="course-chip" data-course-id="<?php echo htmlspecialchars($course['id']); ?>">
                                <?php echo htmlspecialchars($course['name']); ?>
                            </span>
                        <?php endforeach; ?>
                    </div>
                    <p class="hint">
                        <a href="assistant-dashboard.php" class="btn btn-secondary">
                            <i class="fas fa-edit"></i> Modify Course Selection
                        </a>
                    </p>
                </div>
                
                <?php if (!empty($_SESSION['assistant_courses'])): ?>
                    <?php foreach ($_SESSION['assistant_courses'] as $courseId): ?>
                        <input type="hidden" name="selected_courses[]" value="<?php echo htmlspecialchars($courseId); ?>">
                    <?php endforeach; ?>
                <?php endif; ?>
                
                <script>
                // Restore selected courses from sessionStorage when coming back from dashboard
                document.addEventListener('DOMContentLoaded', function() {
                    const tempCourses = sessionStorage.getItem('temp_selected_courses');
                    if (tempCourses) {
                        const courses = JSON.parse(tempCourses);
                        const courseChips = document.getElementById('selected-courses-list');
                        
                        // Update the UI to show the modified courses
                        if (courseChips && courses.length > 0) {
                            // Clear existing chips
                            courseChips.innerHTML = '';
                            
                            // Add new chips
                            courses.forEach(courseId => {
                                // In a real implementation, you would fetch course names from the server
                                // For now, we'll just show the IDs
                                const chip = document.createElement('span');
                                chip.className = 'course-chip';
                                chip.textContent = 'Course ' + courseId;
                                courseChips.appendChild(chip);
                                
                                // Update hidden inputs
                                const hiddenInput = document.createElement('input');
                                hiddenInput.type = 'hidden';
                                hiddenInput.name = 'selected_courses[]';
                                hiddenInput.value = courseId;
                                document.querySelector('form').appendChild(hiddenInput);
                            });
                            
                            // Clear the temp storage
                            sessionStorage.removeItem('temp_selected_courses');
                        }
                    }
                });
                </script>
                
                <div class="form-actions">
                    <button type="submit" name="save_profile" class="btn btn-primary">
                        <i class="fas fa-save"></i> Save Profile
                    </button>
                </div>
            </form>
        </div>
    </div>

