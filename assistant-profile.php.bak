<?php
// Include session.php first to handle session start
require_once 'session.php';
require_once 'config.php';

// Debug: Check if database connection is working
error_log('=== Checking Database Connection ===');
require_once 'functions.php';

global $conn;
if (!isset($conn) || !$conn) {
    error_log('Database connection failed!');
    die('Database connection failed. Please try again later.');
} else {
    error_log('Database connection successful');
    
    // Check if assistants table exists and has required columns
    $result = $conn->query("SHOW TABLES LIKE 'assistants'");
    if ($result->num_rows == 0) {
        error_log('Error: assistants table does not exist');
    } else {
        error_log('Assistants table exists');
        
        // Check table structure
        $columns = $conn->query("SHOW COLUMNS FROM assistants");
        $requiredColumns = ['id', 'user_id', 'telegram', 'phone', 'bio', 'availability'];
        $existingColumns = [];
        
        while ($column = $columns->fetch_assoc()) {
            $existingColumns[] = $column['Field'];
        }
        
        $missingColumns = array_diff($requiredColumns, $existingColumns);
        if (!empty($missingColumns)) {
            error_log('Missing columns in assistants table: ' . implode(', ', $missingColumns));
        } else {
            error_log('All required columns exist in assistants table');
        }
    }
}

// Debug logging
error_log('=== Assistant Profile Page Loaded ===');
error_log('POST data: ' . print_r($_POST, true));
error_log('SESSION data: ' . print_r($_SESSION, true));

// Check if user is logged in, is an assistant, and has selected courses
if (!isLoggedIn() || !isset($_SESSION['user_role']) || $_SESSION['user_role'] !== 'assist' || !isset($_SESSION['assistant_courses'])) {
    header("Location: assistant-dashboard.php");
    exit();
}

$userId = $_SESSION['user_id'];
$userData = getUserData($userId);
$error = '';
$success = '';

// Handle form submission
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['save_profile'])) {
    $bio = trim($_POST['bio'] ?? '');
    $availability = trim($_POST['availability'] ?? '');
    $contactInfo = trim($_POST['contact_info'] ?? '');
    
    // Debug log form data
    error_log('Form submitted with data:');
    error_log('- Bio: ' . $bio);
    error_log('- Availability: ' . $availability);
    error_log('- Contact Info: ' . $contactInfo);
    
    // Get selected courses from both session and POST data
    $selectedCourses = [];
    
    // First, check if we have courses in POST data (from hidden inputs)
    if (!empty($_POST['selected_courses']) && is_array($_POST['selected_courses'])) {
        $selectedCourses = array_filter(array_map('trim', $_POST['selected_courses']), function($courseId) {
            return !empty($courseId);
        });
        error_log('Courses from POST: ' . print_r($selectedCourses, true));
    } 
    // Fall back to session if no courses in POST
    elseif (!empty($_SESSION['assistant_courses'])) {
        $selectedCourses = array_filter((array)$_SESSION['assistant_courses'], function($courseId) {
            return !empty($courseId);
        });
        error_log('Courses from SESSION: ' . print_r($selectedCourses, true));
    } else {
        error_log('No courses found in POST or SESSION');
    }
    
    // Debug log the courses being saved
    error_log('Saving profile with courses: ' . print_r($selectedCourses, true));
    error_log('POST data: ' . print_r($_POST, true));
    error_log('Session data: ' . print_r($_SESSION, true));
    
    // Basic validation - using username as full_name
    if (true) {
        // Save profile to database
        error_log('Calling saveAssistantProfile with params:');
        error_log('- User ID: ' . $userId);
        error_log('- Courses: ' . print_r($selectedCourses, true));
        error_log('- Contact Info: ' . $contactInfo);
        error_log('- Bio: ' . $bio);
        error_log('- Availability: ' . $availability);
        
        // Validate required fields
        if (empty($bio) || empty($availability) || empty($contactInfo)) {
            $error = 'All fields are required.';
            error_log('Validation failed: Required fields are empty');
        } else {
            // Save the profile
            $result = saveAssistantProfile($userId, $selectedCourses, $contactInfo, $contactInfo, $bio, $availability);
            
            if ($result) {
                error_log('Profile saved successfully');
                
                // Clear the courses from session after saving profile
                if (isset($_SESSION['assistant_courses'])) {
                    unset($_SESSION['assistant_courses']);
                }
                
                // Set success message
                $_SESSION['success'] = 'Profile saved successfully!';
                
                // Redirect to dashboard
                header('Location: assistant-dashboard.php');
                exit();
            } else {
                $error = 'Failed to save profile. Please try again.';
                error_log('Failed to save profile.');
                
                // Log database error if available
                global $conn;
                if (isset($conn) && $conn->error) {
                    error_log('Database error: ' . $conn->error);
                }
            }
        }
    }
}
?>
