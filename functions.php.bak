<?php
// Debug: Check if config.php exists and is readable
if (!file_exists('config.php') || !is_readable('config.php')) {
    die('Error: config.php is missing or not readable');
}

// Database connection
require_once 'config.php';

// Debug: Check if database connection is working
try {
    if (!isset($conn) || !$conn->ping()) {
        throw new Exception('Database connection failed in functions.php');
    }
} catch (Exception $e) {
    die('Database connection error in functions.php: ' . $e->getMessage());
}

// Debug: Check if function already exists
if (!function_exists('getYearName')) {
    error_log('getYearName function does not exist, defining it now');
}

// Helper function to execute query
function executeQuery($sql, $params = []) {
    global $conn;
    if (empty($params)) {
        return $conn->query($sql);
    }
    $stmt = $conn->prepare($sql);
    $stmt->execute($params);
    return $stmt;
}


// Helper function to get all rows from a table
function getAllFromTable($table) {
    global $conn;
    $result = $conn->query("SELECT * FROM $table");
    $rows = [];
    while ($row = $result->fetch_assoc()) {
        $rows[] = $row;
    }
    return $rows;
}

// Helper function to get row by ID from a table
function getFromTableById($table, $id, $idColumn = 'id') {
    global $conn;
    $sql = "SELECT * FROM $table WHERE $idColumn = ?";
    $stmt = $conn->prepare($sql);
    $stmt->bind_param("i", $id);
    $stmt->execute();
    return $stmt->get_result()->fetch_assoc();
}

// Helper function to insert into table
function insertIntoTable($table, $data) {
    global $conn;
    $columns = implode(", ", array_keys($data));
    $values = implode(", ", array_fill(0, count($data), '?'));
    $sql = "INSERT INTO $table ($columns) VALUES ($values)";
    $stmt = $conn->prepare($sql);
    $types = str_repeat('s', count($data));
    $stmt->bind_param($types, ...array_values($data));
    return $stmt->execute();
}

// Helper function to update table
function updateTable($table, $data, $id, $idColumn = 'id') {
    global $conn;
    $set = implode(" = ?, ", array_keys($data)) . " = ?";
    $sql = "UPDATE $table SET $set WHERE $idColumn = ?";
    $stmt = $conn->prepare($sql);
    $values = array_values($data);
    $values[] = $id;
    $types = str_repeat('s', count($data) + 1);
    $stmt->bind_param($types, ...$values);
    return $stmt->execute();
}

// User authentication functions
function loginUser($email, $password) {
    global $conn;
    
    // Prepare and execute query to find user by email or username
    $stmt = $conn->prepare("SELECT id, username, email, password, user_role FROM users WHERE email = ? OR username = ?");
    $stmt->bind_param("ss", $email, $email);
    $stmt->execute();
    $result = $stmt->get_result();
    
    if ($result->num_rows === 1) {
        $user = $result->fetch_assoc();
        
        // Verify password
        if (password_verify($password, $user['password'])) {
            // Set user roles based on user_role
            $roles = [];
            if ($user['user_role'] === 'assist') {
                $roles[] = 'assist';
                // Add student role if assistants can also be students
                $roles[] = 'student';
            } else {
                $roles[] = 'student';
            }
            
            // Start session and set user data
            $_SESSION['user_id'] = $user['id'];
            $_SESSION['username'] = $user['username'];
            $_SESSION['email'] = $user['email'];
            $_SESSION['user_role'] = $user['user_role'];
            $_SESSION['roles'] = $roles;
            
            return true;
        }
    }
    
    return false;
}

// Function to check if user is an assistant and return assistant ID if they are
function isUserAssistant($userId) {
    global $conn;
    
    error_log("=== Checking if user is an assistant ===");
    error_log("User ID: $userId");
    
    // First check if we have the assistant ID in session
    if (isset($_SESSION['assistant_id'])) {
        error_log("Found assistant ID in session: " . $_SESSION['assistant_id']);
        return $_SESSION['assistant_id'];
    }
    
    try {
        // Check in assistants table
        $stmt = $conn->prepare("SELECT id, user_id FROM assistants WHERE user_id = ?");
        if (!$stmt) {
            throw new Exception("Prepare failed: " . $conn->error);
        }
        
        $stmt->bind_param("i", $userId);
        if (!$stmt->execute()) {
            throw new Exception("Execute failed: " . $stmt->error);
        }
        
        $result = $stmt->get_result();
        
        if ($result->num_rows > 0) {
            $assistant = $result->fetch_assoc();
            $_SESSION['assistant_id'] = $assistant['id']; // Cache in session
            error_log("Found assistant in database. ID: " . $assistant['id']);
            return $assistant['id'];
        }
        
        error_log("No assistant profile found for user ID: $userId");
        return false;
        
    } catch (Exception $e) {
        error_log("Error in isUserAssistant: " . $e->getMessage());
        error_log("Stack trace: " . $e->getTraceAsString());
        return false;
    }
}

// Process login with intent handling (multi-role)
function processLogin($email, $password, $intent = '') {
    global $conn;
    
    // Map legacy 'get' intent to 'student' for backward compatibility
    if ($intent === 'get') {
        $intent = 'student';
    }
    
    // First check if user exists in database
    $sql = "SELECT * FROM users WHERE email = ?";
    $stmt = $conn->prepare($sql);
    $stmt->bind_param("s", $email);
    $stmt->execute();
    $result = $stmt->get_result();
    
    if ($result->num_rows === 0) {
        return "Invalid email or password";
    }
    
    $user = $result->fetch_assoc();
    
    // Verify password
    if (!password_verify($password, $user['password'])) {
        return "Invalid email or password";
    }
    
    // Get user roles
    $roles = [];
    if (!empty($user['roles'])) {
        // If roles is a JSON string, decode it
        $roles = is_string($user['roles']) ? json_decode($user['roles'], true) : $user['roles'];
    }
    
    // For backward compatibility, if no roles are set, check if user is an assistant
    if (empty($roles)) {
        $roles = ['student'];
        // Check if user is an assistant
        $stmt = $conn->prepare("SELECT id FROM assistants WHERE user_id = ?");
        $stmt->bind_param("i", $user['id']);
        $stmt->execute();
        if ($stmt->get_result()->num_rows > 0) {
            $roles[] = 'assist';
        }
    }
    
    // If no intent specified, use first role
    if (empty($intent)) {
        $intent = $roles[0];
    }
    
    // Check if the user has the requested role
    if (!in_array($intent, $roles)) {
        return "This account does not have the requested role.";
    }
    
    // Set session data
    $_SESSION['user_id'] = $user['id'];
    $_SESSION['username'] = $user['username'];
    $_SESSION['email'] = $user['email'];
    $_SESSION['user_role'] = $intent;
    $_SESSION['roles'] = $roles;
    
    // Redirect based on intent
    if ($intent === 'assist') {
        header("Location: assistant-dashboard.php");
    } else {
        header("Location: courses.php");
    }
    exit();
}


// Helper function to check if user is logged in
function isLoggedIn() {
    return isset($_SESSION['user_id']);
}

// Function to register new users (multi-role support)
function registerUser($username, $email, $password, $year, $user_role = 'student') {
    global $conn;
    
    // Debugging - Log attempt
    error_log("Attempting to register user: username=$username, email=$email, role=$user_role");
    
    // Check if email already exists
    $stmt = $conn->prepare("SELECT id, roles FROM users WHERE email = ?");
    $stmt->bind_param("s", $email);
    
    if (!$stmt->execute()) {
        error_log("Error checking email: " . $conn->error);
        return "Error checking email: " . $conn->error;
    }
    
    $result = $stmt->get_result();
    
    if ($result->num_rows > 0) {
        // User exists, check if they already have this role
        $user = $result->fetch_assoc();
        $roles = json_decode($user['roles'], true) ?: [];
        
        if (in_array($user_role, $roles)) {
            return "You already have this role.";
        }
        
        // Add the new role
        $roles[] = $user_role;
        $rolesJson = json_encode($roles);
        
        // Update user with new role
        $updateStmt = $conn->prepare("UPDATE users SET roles = ? WHERE id = ?");
        $updateStmt->bind_param("si", $rolesJson, $user['id']);
        
        if (!$updateStmt->execute()) {
            error_log("Error updating roles: " . $conn->error);
            return "Error updating roles: " . $conn->error;
        }
        
        // Note: Assistant profile will be created when user sets up their assistant profile later
        
        return true;
    }
    
    // Check if username is taken
    $stmt = $conn->prepare("SELECT id FROM users WHERE username = ?");
    $stmt->bind_param("s", $username);
    
    if (!$stmt->execute()) {
        error_log("Error checking username: " . $conn->error);
        return "Error checking username: " . $conn->error;
    }
    
    if ($stmt->get_result()->num_rows > 0) {
        return "Username already taken.";
    }
    
    // Create new user
    $hashedPassword = password_hash($password, PASSWORD_DEFAULT);
    $roles = json_encode([$user_role]);
    
    $insertUser = $conn->prepare("INSERT INTO users (username, email, password, academic_year, roles) VALUES (?, ?, ?, ?, ?)");
    $insertUser->bind_param("sssss", $username, $email, $hashedPassword, $year, $roles);
    
    if (!$insertUser->execute()) {
        error_log("Error inserting user: " . $conn->error);
        return "Error inserting user: " . $conn->error;
    }
    
    $userId = $conn->insert_id;
    
    // Note: Assistant profile will be created when user sets up their assistant profile later
    
    // Debugging - Log success
    error_log("Successfully registered user: id=$userId, username=$username, email=$email");
    return true;
}

// Function to update assistant's courses
function updateAssistantCourses($assistantId, $courseIds) {
    global $conn;
    
    // Enable error reporting for mysqli
    mysqli_report(MYSQLI_REPORT_ERROR | MYSQLI_REPORT_STRICT);
    
    error_log("=== Starting updateAssistantCourses ===");
    error_log("Assistant ID: " . $assistantId);
    error_log("Courses to update: " . print_r($courseIds, true));
    
    // Validate assistant ID
    if (empty($assistantId) || !is_numeric($assistantId)) {
        $error = "Invalid assistant ID provided";
        error_log("Error: " . $error);
        throw new Exception($error);
    }
    
    // Ensure courseIds is an array
    if (!is_array($courseIds)) {
        error_log("Warning: courseIds is not an array, converting to empty array");
        $courseIds = [];
    }
    
    // Remove any empty or invalid course IDs and ensure unique values
    $courseIds = array_unique(array_filter($courseIds, function($id) {
        return !empty($id) && (is_string($id) || is_numeric($id));
    }));
    
    // Convert all course IDs to strings to ensure consistent comparison
    $courseIds = array_map('strval', $courseIds);
    
    error_log("Processed course IDs: " . print_r($courseIds, true));
    
    try {
        // Start transaction
        error_log("Starting database transaction");
        $conn->begin_transaction();
        
        // First, remove all existing courses for this assistant
        $deleteStmt = $conn->prepare("DELETE FROM assistant_courses WHERE assistant_id = ?");
        if (!$deleteStmt) {
            throw new Exception("Prepare DELETE failed: " . $conn->error);
        }
        
        $deleteStmt->bind_param("i", $assistantId);
        if (!$deleteStmt->execute()) {
            throw new Exception("Failed to remove existing courses: " . $deleteStmt->error);
        }
        $deleteStmt->close();
        
        // If there are courses to add, insert them
        if (!empty($courseIds)) {
            // Create a single INSERT statement with multiple value sets
            $values = [];
            $types = '';
            $params = [];
            
            foreach ($courseIds as $courseId) {
                $values[] = "(?, ?)";
                $types .= 'is';
                $params[] = $assistantId;
                $params[] = $courseId;
            }
            
            $sql = "INSERT IGNORE INTO assistant_courses (assistant_id, course_id) VALUES " . 
                   implode(", ", $values);
            
            $insertStmt = $conn->prepare($sql);
            if (!$insertStmt) {
                throw new Exception("Prepare INSERT failed: " . $conn->error);
            }
            
            // Bind parameters
            $insertStmt->bind_param($types, ...$params);
            
            if (!$insertStmt->execute()) {
                throw new Exception("Failed to add courses: " . $insertStmt->error);
            }
            
            $insertStmt->close();
            error_log("Successfully added " . count($courseIds) . " courses");
        }
        
        // Commit transaction
        $conn->commit();
        error_log("Successfully updated courses for assistant $assistantId");
        return true;
        
    } catch (mysqli_sql_exception $e) {
        // Rollback on error
        if (isset($conn)) {
            try {
                $conn->rollback();
                error_log("Transaction rolled back due to error");
            } catch (Exception $rollbackEx) {
                error_log("Error during rollback: " . $rollbackEx->getMessage());
            }
        }
        
        $errorMsg = "Database error in updateAssistantCourses: " . $e->getMessage() . 
                   "\nError code: " . $e->getCode() . 
                   "\n" . $e->getTraceAsString();
        error_log($errorMsg);
        
        throw new Exception("Failed to update course selections. Please try again.");
        
    } catch (Exception $e) {
        // Rollback on error
        if (isset($conn)) {
            try {
                $conn->rollback();
                error_log("Transaction rolled back due to error");
            } catch (Exception $rollbackEx) {
                error_log("Error during rollback: " . $rollbackEx->getMessage());
            }
        }
        
        $errorMsg = "Error in updateAssistantCourses: " . $e->getMessage() . 
                   "\n" . $e->getTraceAsString();
        error_log($errorMsg);
        
        throw new Exception("Failed to update course selections. " . $e->getMessage());
    }
}

// Function to update user's full name
function updateUserFullName($userId, $fullName) {
    global $conn;
    
    $sql = "UPDATE users SET full_name = ? WHERE id = ?";
    $stmt = $conn->prepare($sql);
    $stmt->bind_param("si", $fullName, $userId);
    return $stmt->execute();
}

// Function to get user data
function getUserData($userId) {
    global $conn;
    
    $stmt = $conn->prepare("SELECT id, username, email, academic_year, roles, created_at, updated_at FROM users WHERE id = ?");
    $stmt->bind_param("i", $userId);
    $stmt->execute();
    $result = $stmt->get_result();
    
    if ($result->num_rows === 1) {
        $user = $result->fetch_assoc();
        // Convert roles from JSON to array
        $user['roles'] = json_decode($user['roles'], true) ?: [];
        return $user;
    }
    
    return null;
}

// Function to get course by ID
function getCourseById($courseId) {
    global $conn;
    $sql = "SELECT * FROM courses WHERE id = ?";
    $stmt = $conn->prepare($sql);
    $stmt->bind_param("s", $courseId);
    $stmt->execute();
    return $stmt->get_result()->fetch_assoc();
}

// Function to get courses by year and semester
function getCoursesByYearAndSemester($year, $semester) {
    global $conn;
    
    // Convert numeric year to year name if needed
    if (is_numeric($year)) {
        $year = getYearName($year);
    }
    
    $sql = "SELECT * FROM courses WHERE year = ? AND semester = ?";
    $stmt = $conn->prepare($sql);
    $stmt->bind_param("si", $year, $semester);
    $stmt->execute();
    $result = $stmt->get_result();
    
    // Log for debugging
    error_log("Query: $sql | Year: $year, Semester: $semester | Rows: " . $result->num_rows);
    
    return $result->fetch_all(MYSQLI_ASSOC);
}

// Function to get all courses
function getAllCourses() {
    global $conn;
    $result = $conn->query("SELECT * FROM courses");
    $courses = [];
    while ($row = $result->fetch_assoc()) {
        $courses[] = $row;
    }
    return $courses;
}

// Function to get all courses that an assistant can potentially assist with
function getCoursesForAssistant($userId) {
    global $conn;
    
    // First, get the assistant's academic year
    $userData = getUserData($userId);
    $academicYear = $userData['academic_year'];
    
    // Convert academic year to numeric value
    $yearValues = [
        'Freshman' => 1,
        'Sophomore' => 2,
        'Junior' => 3,
        'Senior' => 4,
        'Graduate' => 5
    ];
    
    $userYearValue = $yearValues[$academicYear] ?? 1;
    
    // Get all courses for years below the assistant's current year
    $sql = "SELECT * FROM courses WHERE ";
    $params = [];
    $types = '';
    
    // Add conditions for each year below the user's year
    foreach ($yearValues as $yearName => $yearNum) {
        if ($yearNum < $userYearValue) {
            if (!empty($params)) {
                $sql .= " OR ";
            }
            $sql .= "year = ?";
            $params[] = $yearName;
            $types .= 's';
        }
    }
    
    // If no years found (shouldn't happen), default to Freshman
    if (empty($params)) {
        $sql .= "year = ?";
        $params[] = 'Freshman';
        $types = 's';
    }
    
    $stmt = $conn->prepare($sql);
    if (!empty($params)) {
        $stmt->bind_param($types, ...$params);
    }
    
    $stmt->execute();
    $result = $stmt->get_result()->fetch_all(MYSQLI_ASSOC);
    
    // Debug log
    error_log("getCoursesForAssistant - User ID: $userId, Academic Year: $academicYear, Found courses: " . count($result));
    
    return $result;
}

// Function to save assistant profile with multiple courses
function saveAssistantProfile($userId, $selectedCourses, $telegram, $phone, $bio, $availability) {
    global $conn;
    
    error_log("=== Starting saveAssistantProfile ===");
    error_log("User ID: $userId");
    error_log("Telegram: $telegram");
    error_log("Phone: $phone");
    error_log("Bio: $bio");
    error_log("Availability: $availability");
    error_log("Selected courses: " . print_r($selectedCourses, true));
    
    // Validate inputs
    if (empty($userId)) {
        error_log("Error: User ID is required");
        return false;
    }
    
    // Ensure selectedCourses is an array
    if (!is_array($selectedCourses)) {
        $selectedCourses = [];
    }
    
    // Start transaction
    $conn->begin_transaction();
    
    try {
        // Check if assistant already exists
        $assistantId = isUserAssistant($userId);
        
        if ($assistantId) {
            error_log("Updating existing assistant with ID: $assistantId");
            // Update existing assistant
            $stmt = $conn->prepare("UPDATE assistants SET telegram = ?, phone = ?, bio = ?, availability = ? WHERE id = ?");
            if (!$stmt) {
                throw new Exception("Prepare failed: " . $conn->error);
            }
            
            $stmt->bind_param("ssssi", $telegram, $phone, $bio, $availability, $assistantId);
            
            if (!$stmt->execute()) {
                throw new Exception("Failed to update assistant profile: " . $stmt->error);
            }
            
            error_log("Successfully updated assistant profile");
        } else {
            error_log("Creating new assistant profile");
            // Insert new assistant without course_id
            $stmt = $conn->prepare("INSERT INTO assistants (user_id, telegram, phone, bio, availability) VALUES (?, ?, ?, ?, ?)");
            if (!$stmt) {
                throw new Exception("Prepare failed: " . $conn->error);
            }
            
            $stmt->bind_param("issss", $userId, $telegram, $phone, $bio, $availability);
            
            if (!$stmt->execute()) {
                throw new Exception("Failed to create assistant profile: " . $stmt->error);
            }
            
            $assistantId = $stmt->insert_id;
            error_log("Created new assistant with ID: $assistantId");
            
            // Add 'assist' role to user if not already present
            $userData = getUserData($userId);
            if (!in_array('assist', $userData['roles'])) {
                error_log("Adding 'assist' role to user");
                $newRoles = array_merge($userData['roles'], ['assist']);
                $rolesJson = json_encode($newRoles);
                
                $updateStmt = $conn->prepare("UPDATE users SET roles = ? WHERE id = ?");
                if (!$updateStmt) {
                    throw new Exception("Prepare failed: " . $conn->error);
                }
                
                $updateStmt->bind_param("si", $rolesJson, $userId);
                if (!$updateStmt->execute()) {
                    throw new Exception("Failed to update user roles: " . $updateStmt->error);
                }
                
                error_log("Successfully updated user roles");
            } else {
                error_log("User already has 'assist' role");
            }
        }
        
        // Now save the courses using the updateAssistantCourses function
        error_log("Updating courses for assistant ID: $assistantId");
        error_log("Courses to save: " . print_r($selectedCourses, true));
        
        // If no courses are selected, ensure we pass an empty array
        if (!is_array($selectedCourses)) {
            $selectedCourses = [];
        }
        
        // Always call updateAssistantCourses, even with empty array to clear existing courses
        error_log("Calling updateAssistantCourses for assistant ID: $assistantId with " . count($selectedCourses) . " courses");
        $coursesUpdated = updateAssistantCourses($assistantId, $selectedCourses);
        
        if (!$coursesUpdated) {
            throw new Exception("Failed to update assistant courses");
        }
        
        error_log("Successfully updated assistant courses");
        
        // Commit the transaction
        if (!$conn->commit()) {
            throw new Exception("Failed to commit transaction");
        }
        
        error_log("Transaction committed successfully");
        return true;
        
    } catch (Exception $e) {
        // Rollback transaction on error
        error_log("Error in saveAssistantProfile: " . $e->getMessage());
        error_log("Stack trace: " . $e->getTraceAsString());
        
        if ($conn) {
            if (!is_null($conn->error)) {
                error_log("MySQL Error: " . $conn->error);
            }
            
            try {
                if ($conn->rollback()) {
                    error_log("Transaction rolled back successfully");
                } else {
                    error_log("Failed to rollback transaction");
                }
            } catch (Exception $rollbackEx) {
                error_log("Error during rollback: " . $rollbackEx->getMessage());
            }
        }
        
        return false;
    }
}

// Function to get tutors by course with search
function getTutorsByCourse($courseId, $searchQuery = '') {
    global $conn;

    $sql = "SELECT DISTINCT 
                u.id as user_id,
                u.username as name,
                u.email,
                u.academic_year as year,
                a.visits,
                a.telegram, 
                a.phone, 
                a.bio
            FROM assistant_courses ac
            JOIN assistants a ON ac.assistant_id = a.id
            JOIN users u ON a.user_id = u.id 
            WHERE ac.course_id = ?";

    $params = [$courseId];
    $types = "s";
    
    if (!empty($searchQuery)) {
        $sql .= " AND (u.username LIKE ? OR u.email LIKE ? OR a.bio LIKE ?)";
        $search = "%" . $searchQuery . "%";
        $params = array_merge($params, [$search, $search, $search]);
        $types .= "sss";
    }

    $stmt = $conn->prepare($sql);
    if (!$stmt) {
        error_log("Prepare failed: " . $conn->error);
        return [];
    }
    
    // Dynamically bind parameters
    if (!empty($params)) {
        $stmt->bind_param($types, ...$params);
    }

    if (!$stmt->execute()) {
        error_log("Query failed: " . $stmt->error);
        return [];
    }
    
    $result = $stmt->get_result();
    $tutors = [];
    
    while ($row = $result->fetch_assoc()) {
        // Ensure all required fields have default values
        $tutor = [
            'user_id' => $row['user_id'] ?? 0,
            'name' => $row['name'] ?? 'Unknown',
            'year' => $row['year'] ?? 'N/A',
            'visits' => $row['visits'] ?? 0,
            'telegram' => $row['telegram'] ?? '',
            'phone' => $row['phone'] ?? '',
            'bio' => $row['bio'] ?? ''
        ];
        $tutors[] = $tutor;
    }
    
    return $tutors;
}

// Function to get courses the user is assisting
function getAssistantCourses($userId) {
    global $conn;
    
    // First, get the assistant ID for this user
    $assistantId = isUserAssistant($userId);
    if (!$assistantId) {
        return [];
    }
    
    // Now get all courses associated with this assistant
    $sql = "SELECT c.* 
            FROM assistant_courses ac 
            JOIN courses c ON ac.course_id = c.id 
            WHERE ac.assistant_id = ?";
            
    $stmt = $conn->prepare($sql);
    if (!$stmt) {
        error_log("Prepare failed: " . $conn->error);
        return [];
    }
    
    $stmt->bind_param("i", $assistantId);
    if (!$stmt->execute()) {
        error_log("Query failed: " . $stmt->error);
        return [];
    }
    
    $result = $stmt->get_result();
    return $result->fetch_all(MYSQLI_ASSOC);
}

// Function to save connection request
function saveConnectionRequest($userId, $tutorId, $courseId, $problemDescription, $telegram = '') {
    global $conn;
    $sql = "INSERT INTO connections (user_id, assistant_id, course_id, problem_description, telegram, status) 
            VALUES (?, ?, ?, ?, ?, 'pending')";
    $stmt = $conn->prepare($sql);
    $stmt->bind_param("iissi", $userId, $tutorId, $courseId, $problemDescription, $telegram);
    return $stmt->execute();
}

// Function to increment tutor visits
function incrementTutorVisits($tutorId) {
    global $conn;
    $sql = "UPDATE assistants SET visits = visits + 1 WHERE user_id = ?";
    $stmt = $conn->prepare($sql);
    $stmt->bind_param("i", $tutorId);
    return $stmt->execute();
}

// Function to save assistant application
function saveAssistantApplication($userId, $courseId, $telegram = '', $phone = '', $otherInfo = '') {
    global $conn;
    $sql = "INSERT INTO assistants (user_id, course_id, telegram, phone, other_info, status) 
            VALUES (?, ?, ?, ?, ?, 'pending')";
    $stmt = $conn->prepare($sql);
    $stmt->bind_param("isssss", $userId, $courseId, $telegram, $phone, $otherInfo);
    return $stmt->execute();
}

// Initialize database with sample data
function initializeDatabase() {
    global $conn;

    // Sample users
    $users = [
        [
            'username' => 'student1',
            'email' => 'student1@example.com',
            'password' => password_hash('password1', PASSWORD_DEFAULT),
            'academic_year' => 'Freshman'
        ],
        [
            'username' => 'assistant1',
            'email' => 'assistant1@example.com',
            'password' => password_hash('password2', PASSWORD_DEFAULT),
            'academic_year' => 'Sophomore'
        ]
    ];

    // Sample courses
    $courses = [
        [
            'id' => 'SE101',
            'name' => 'Introduction to Programming',
            'code' => 'SE101',
            'credit_hours' => 3,
            'year' => 'Freshman',
            'semester' => 1,
            'description' => 'Introduction to programming concepts and basic programming skills.'
        ],
        [
            'id' => 'SE102',
            'name' => 'Discrete Mathematics',
            'code' => 'SE102',
            'credit_hours' => 3,
            'year' => 'Freshman',
            'semester' => 1,
            'description' => 'Mathematical foundations for computer science.'
        ]
    ];
    
    // Insert sample courses into database
    foreach ($courses as $course) {
        $stmt = $conn->prepare("INSERT IGNORE INTO courses (id, name, code, credit_hours, year, semester, description) 
                              VALUES (?, ?, ?, ?, ?, ?, ?)");
        $stmt->bind_param("sssisis", 
            $course['id'],
            $course['name'],
            $course['code'],
            $course['credit_hours'],
            $course['year'],
            $course['semester'],
            $course['description']
        );
        $stmt->execute();
    }
}

/**
 * Convert numeric year to academic year name
 * @param int|string $yearNumber The year number (1-5)
 * @return string The academic year name
 */
function getYearName($yearNumber) {
    $years = [
        1 => 'Freshman',
        2 => 'Sophomore',
        3 => 'Junior',
        4 => 'Senior',
        5 => 'Graduate'
    ];
    
    $yearNumber = (int)$yearNumber;
    $result = $years[$yearNumber] ?? 'Unknown';
    
    // Debug log
    error_log("getYearName called with: " . print_r($yearNumber, true) . ", returning: " . $result);
    
    return $result;
}

/**
 * Get an icon for a course based on its name
 * @param string $courseName The name of the course
 * @return string HTML entity for the icon
 */
function getCourseIcon($courseName) {
    $defaultIcon = '📚'; // Default book icon
    
    // Return default icon if courseName is not a string or is empty
    if (!is_string($courseName) || trim($courseName) === '') {
        return $defaultIcon;
    }
    
    $courseName = strtolower(trim($courseName));
    
    // Map course name patterns to icons
    if (strpos($courseName, 'programming') !== false || 
        strpos($courseName, 'software') !== false || 
        strpos($courseName, 'computer') !== false) {
        return '💻';
    } elseif (strpos($courseName, 'math') !== false || 
              strpos($courseName, 'calculus') !== false || 
              strpos($courseName, 'algebra') !== false) {
        return '📐';
    } elseif (strpos($courseName, 'physics') !== false) {
        return '⚛️';
    } elseif (strpos($courseName, 'chemistry') !== false) {
        return '🧪';
    } elseif (strpos($courseName, 'biology') !== false) {
        return '🧬';
    } elseif (strpos($courseName, 'english') !== false || 
              strpos($courseName, 'writing') !== false) {
        return '📝';
    } elseif (strpos($courseName, 'history') !== false) {
        return '🏛️';
    } elseif (strpos($courseName, 'business') !== false || 
              strpos($courseName, 'management') !== false) {
        return '💼';
    } elseif (strpos($courseName, 'art') !== false || 
              strpos($courseName, 'design') !== false) {
        return '🎨';
    } elseif (strpos($courseName, 'music') !== false) {
        return '🎵';
    } elseif (strpos($courseName, 'language') !== false) {
        return '🌐';
    }
    
    return $defaultIcon;
}

/**
 * Get courses by their IDs
 * @param array $courseIds Array of course IDs
 * @return array Array of course data
 */
function getCoursesByIds($courseIds) {
    global $conn;
    
    if (empty($courseIds)) {
        return [];
    }
    
    // Create placeholders for the prepared statement
    $placeholders = rtrim(str_repeat('?,', count($courseIds)), ',');
    
    $sql = "SELECT * FROM courses WHERE id IN ($placeholders)";
    $stmt = $conn->prepare($sql);
    
    // Bind parameters
    $types = str_repeat('s', count($courseIds));
    $stmt->bind_param($types, ...$courseIds);
    
    $stmt->execute();
    $result = $stmt->get_result();
    
    $courses = [];
    while ($row = $result->fetch_assoc()) {
        $courses[] = $row;
    }
    
    return $courses;
}

